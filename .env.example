# Drug Interaction Visualizer — environment
# Copy to .env and adjust. Never commit real .env files.

# Dataset (must exist — run scripts/fetch_dataset.sh + the build command)
APP_DATASET_PATH=data/ddi_dataset.json

# LLM: stub mode returns deterministic offline explanations (no GPU needed).
APP_LLM_STUB=true
# Provider used when APP_LLM_STUB=false: ollama (local GPU) | anthropic
APP_LLM_PROVIDER=ollama
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:14b
APP_ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=   (required when APP_LLM_PROVIDER=anthropic)
# Shared Ollama: models are used as-is (never pulled/changed); our model is
# released after this keep-alive so other apps keep their memory.
APP_OLLAMA_KEEP_ALIVE=2m

# Hybrid drug search: offline alias table + live RxNav (NLM) fallback
APP_ALIASES_PATH=data/aliases.json
APP_RXNAV_ENABLED=true

# API port
APP_PORT=8001
