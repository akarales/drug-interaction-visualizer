# Drug Interaction Visualizer — environment
# Copy to .env and adjust. Never commit real .env files.

# Dataset (must exist — run scripts/fetch_dataset.sh + the build command)
APP_DATASET_PATH=data/ddi_dataset.json

# LLM: stub mode returns deterministic offline explanations (no GPU needed).
APP_LLM_STUB=true
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:14b

# Port (8000 is used by ZAP_AGI on this machine)
APP_PORT=8001
